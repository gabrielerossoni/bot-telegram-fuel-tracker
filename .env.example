# 1. Copia questo file in .env
# 2. Compila i valori qui sotto

# Token del bot da @BotFather
BOT_TOKEN=il_tuo_token_qui

# URL pubblico HTTPS della WebApp (obbligatorio per Telegram Mini App)
WEBAPP_URL=

# Porta del server (default 8080)
PORT=8080

# --- Default Fallback (opzionale, per report CLI) ---
CHAT_ID=
LAT=
LON=
RAGGIO=
CARBURANTE=
SELF_SERVICE=true
SOGLIA=
